<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目基本信息 -->
    <groupId>com.zone.middleware</groupId>
    <artifactId>zone-middleware-support</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>zone-middleware-support</name>
    <description>Zone中间件支撑二方库</description>

    <!-- 子模块配置 -->
    <modules>
        <module>zone-middleware-common</module>
        <module>zone-middleware</module>
        <module>zone-middleware-suite</module>
    </modules>

    <!-- 属性配置 -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.5.6</spring.boot.version>
        <fastjson2.version>2.0.53</fastjson2.version>
        <useragent.utils.version>1.21</useragent.utils.version>
        <mybatis.plus.version>3.5.12</mybatis.plus.version>
        <druid.version>1.2.18</druid.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <!-- 依赖管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本项目模块 -->
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-database</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zone.middleware</groupId>
                <artifactId>zone-middleware-suite</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 统一 JSON：fastjson2（工作区规范，不使用 jackson） -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- 浏览器 User-Agent 解析（开源工具，无传递依赖） -->
            <dependency>
                <groupId>eu.bitwalker</groupId>
                <artifactId>UserAgentUtils</artifactId>
                <version>${useragent.utils.version}</version>
            </dependency>

            <!-- MyBatis-Plus（Boot 3 专用 starter；3.5.9+ 分页拦截器依赖拆分至独立 jsqlparser artifact） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>

            <!-- Druid 连接池（裸依赖，手工装配） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid</artifactId>
                <version>${druid.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 构建配置 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>21</release>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
