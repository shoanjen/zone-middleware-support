<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父项目信息 -->
    <parent>
        <groupId>com.zone.middleware</groupId>
        <artifactId>zone-middleware</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- 模块基本信息 -->
    <artifactId>zone-middleware-security</artifactId>
    <packaging>jar</packaging>

    <name>zone-middleware-security</name>
    <description>Zone中间件安全支撑组件：接口签名鉴权（MD5 签名 + 注解声明 + 防重放）与登录令牌（不透明令牌 + Redis）</description>

    <!-- 依赖配置 -->
    <dependencies>
        <!-- Spring Boot 基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring MVC：拦截器与注解探测（BOM 管版本，不带内嵌容器与 jackson） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>

        <!-- Servlet API（由上游容器提供，不传递） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 统一 JSON：fastjson2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 公共模块 -->
        <dependency>
            <groupId>com.zone.middleware</groupId>
            <artifactId>zone-middleware-common</artifactId>
        </dependency>

        <!-- Redis 支撑：登录令牌与防重放 nonce 存储 -->
        <dependency>
            <groupId>com.zone.middleware</groupId>
            <artifactId>zone-middleware-redis</artifactId>
        </dependency>

        <!-- 日志门面（库内埋点统一使用 ZoneLog） -->
        <dependency>
            <groupId>com.zone.middleware</groupId>
            <artifactId>zone-middleware-log</artifactId>
        </dependency>

        <!-- Lombok：编译期注解处理，optional 不传递给上游 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试用 Servlet Web 环境（MockMvc + DispatcherServlet 装配） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
