<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父项目信息 -->
    <parent>
        <groupId>com.zone.middleware</groupId>
        <artifactId>zone-middleware</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 模块基本信息 -->
    <artifactId>zone-middleware-http</artifactId>
    <packaging>jar</packaging>

    <name>zone-middleware-http</name>
    <description>Zone中间件HTTP支撑组件：基于JDK 21 HttpClient的ZoneHttpTemplate（鉴权扩展、重试与熔断）</description>

    <!-- 依赖配置：JDK 内置 HttpClient，零额外 HTTP 依赖 -->
    <dependencies>
        <!-- Spring Boot 基础（不含 web/jackson） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 统一 JSON：fastjson2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 公共模块 -->
        <dependency>
            <groupId>com.zone.middleware</groupId>
            <artifactId>zone-middleware-common</artifactId>
        </dependency>

        <!-- 日志门面（库内埋点统一使用 ZoneLog） -->
        <dependency>
            <groupId>com.zone.middleware</groupId>
            <artifactId>zone-middleware-log</artifactId>
        </dependency>

        <!-- Lombok：编译期注解处理，optional 不传递给上游 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
